import numpy as np
from keras.models import Model
from keras.layers import Input, Bidirectional, LSTM, GRU, Dense, Dropout, Multiply, Concatenate, BatchNormalization
from keras.regularizers import l2
from keras.optimizers import Adam
from keras.callbacks import ReduceLROnPlateau
from sklearn.metrics import r2_score

# Example data shape
time_step = 100
input_dim = 1

# Input layer
input_layer = Input(shape=(time_step, input_dim))

# LSTM Branch with L2 Regularization and Batch Normalization
lstm_out = Bidirectional(LSTM(units=50, return_sequences=True, kernel_regularizer=l2(1e-4)))(input_layer)
attention_probs_lstm = Dense(time_step, activation='softmax', name='attention_probs_lstm')(lstm_out)
attention_mul_lstm = Multiply(name='attention_mul_lstm')([lstm_out, attention_probs_lstm])
batch_norm_lstm = BatchNormalization()(attention_mul_lstm)

# GRU Branch with L2 Regularization and Batch Normalization
gru_out = Bidirectional(GRU(units=50, return_sequences=True, kernel_regularizer=l2(1e-4)))(input_layer)
attention_probs_gru = Dense(time_step, activation='softmax', name='attention_probs_gru')(gru_out)
attention_mul_gru = Multiply(name='attention_mul_gru')([gru_out, attention_probs_gru])
batch_norm_gru = BatchNormalization()(attention_mul_gru)

# Concatenate outputs of both branches
concat_out = Concatenate(name='concatenation_layer')([batch_norm_lstm[:, -1, :], batch_norm_gru[:, -1, :]])
batch_norm_concat = BatchNormalization()(concat_out)

# Dropout for regularization
dropout = Dropout(0.6)(batch_norm_concat)

# Output layer
output_layer = Dense(units=1, kernel_regularizer=l2(1e-4), name='output_layer')(dropout)

# Define model
model = Model(inputs=input_layer, outputs=output_layer)

# Compile model with gradient clipping
optimizer = Adam(learning_rate=0.0001, clipnorm=1.0)
model.compile(optimizer=optimizer, loss='mean_squared_error', metrics=['mean_squared_error', 'mean_absolute_error'])

# Learning rate scheduler
lr_scheduler = ReduceLROnPlateau(monitor='val_loss', factor=0.5, patience=5, min_lr=1e-6)

# Summary of the model
model.summary()

# Train model (replace with your actual dataset)
history = model.fit(X_train, y_train, epochs=150, batch_size=32, validation_split=0.3, callbacks=[lr_scheduler])

# Evaluate model
