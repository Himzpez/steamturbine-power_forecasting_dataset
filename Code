# Fill NaN values
cleaned_dataset = NewDataSet.fillna(method='ffill')

print("Shape after filling NaN:", cleaned_dataset.shape)

# ===============================
# Preparing Target Variable
# ===============================
y = cleaned_dataset["kVA_value"]

# Normalize
scaler = MinMaxScaler(feature_range=(0,1))
y = scaler.fit_transform(np.array(y).reshape(-1,1))

print("Normalized data:")
print(y[:10])


# ===============================
# Train / Test / Validation Split
# ===============================
training_size = int(len(y)*0.80)
test_size = len(y)-training_size
val_size = int(training_size*0.20)

train_data = y[0:training_size-val_size,:]
test_data = y[training_size:len(y),:1]
val_data = y[len(y)-test_size-val_size:len(y)-test_size,:1]


# ===============================
# Dataset Creation Function
# ===============================
def create_dataset(dataset, time_step=1):
    dataX, dataY = [], []

    for i in range(len(dataset)-time_step-1):
        a = dataset[i:(i+time_step),0]
        dataX.append(a)
        dataY.append(dataset[i+time_step,0])

    return np.array(dataX), np.array(dataY)


time_step = 100

X_train, y_train = create_dataset(train_data, time_step)
X_test, ytest = create_dataset(test_data, time_step)
X_val, yval = create_dataset(val_data, time_step)

X_train = X_train.reshape(X_train.shape[0],X_train.shape[1],1)
X_test = X_test.reshape(X_test.shape[0],X_test.shape[1],1)
X_val = X_val.reshape(X_val.shape[0],X_val.shape[1],1)


# ===============================
# Transformer Model
# ===============================
input_layer = Input(shape=(time_step,1))

embedding_layer = Dense(64, activation='linear')(input_layer)

attn_output_1 = MultiHeadAttention(num_heads=8, key_dim=64)(embedding_layer, embedding_layer)
attn_output_1 = Dropout(0.2)(attn_output_1)
attn_output_1 = Add()([attn_output_1, embedding_layer])
attn_output_1 = LayerNormalization(epsilon=1e-6)(attn_output_1)

ffn_output_1 = Dense(2048, activation='relu')(attn_output_1)
ffn_output_1 = Dense(64)(ffn_output_1)
ffn_output_1 = Dropout(0.2)(ffn_output_1)
ffn_output_1 = Add()([ffn_output_1, attn_output_1])
ffn_output_1 = LayerNormalization(epsilon=1e-6)(ffn_output_1)

attn_output_2 = MultiHeadAttention(num_heads=8, key_dim=64)(ffn_output_1, ffn_output_1)
attn_output_2 = Dropout(0.2)(attn_output_2)
attn_output_2 = Add()([attn_output_2, ffn_output_1])
attn_output_2 = LayerNormalization(epsilon=1e-6)(attn_output_2)

ffn_output_2 = Dense(2048, activation='relu')(attn_output_2)
ffn_output_2 = Dense(64)(ffn_output_2)
ffn_output_2 = Dropout(0.2)(ffn_output_2)
ffn_output_2 = Add()([ffn_output_2, attn_output_2])
ffn_output_2 = LayerNormalization(epsilon=1e-6)(ffn_output_2)

output_layer = Dense(1, activation='linear')(ffn_output_2)

model = Model(inputs=input_layer, outputs=output_layer)

model.compile(
    optimizer=Adam(learning_rate=0.001),
    loss='mean_squared_error',
    metrics=['mean_squared_error']
)

early_stopping = EarlyStopping(monitor='val_loss', patience=10, restore_best_weights=True)

history = model.fit(
    X_train, y_train,
    epochs=150,
    batch_size=32,
    validation_data=(X_val, yval),
    callbacks=[early_stopping]
)

# ===============================
# Evaluation
# ===============================
test_loss, test_mse = model.evaluate(X_test, ytest)

rmse = np.sqrt(test_mse)
print("Test RMSE:", rmse)

y_pred = model.predict(X_test)

r_squared = r2_score(ytest.reshape(-1), y_pred.reshape(-1))
print("Test R²:", r_squared)


